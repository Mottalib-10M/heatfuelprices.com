---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/heating-fuel-price/" title="Heating oil and propane price this week" width="100%" height="640" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed this week's heating oil and propane price lookup, free" description="Local newsrooms, town pages and community forums can embed the weekly heating oil and propane price lookup by state with one iframe line. No cookie, no tracking, no dealer form." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the lookup', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the lookup' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the weekly price lookup</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. Each Wednesday of the heating season the prices behind it refresh, and the embedded lookup follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the lookup visible, do not alter the frame, and do not place it next to a dealer form or an offer to sell fuel. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Heating oil and propane price by state</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/heating-fuel-price/" title="Heating oil and propane price this week" width="100%" height="640" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
