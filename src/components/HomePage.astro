---
/**
 * Home (the pillar): this week's price lookup first, the folded answer, the 38 surveyed states in one
 * table, how to read the survey, the pages by group, long text in accordions, FAQ.
 * Text: src/content/home.ts. Tables are generated from the data asset, so they carry data-chrome.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import SeasonChart from './SeasonChart.astro';
import { HOME } from '../content/home';
import { route, ROUTES } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, SOURCES, table } from '../lib/helpers';
import { GUIDES, STATE_PAGES, stateId } from '../lib/pages';
import { KIT as K } from '../lib/kit';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED } from '../data/site-config';
const lang = 'en';
const x = HOME;
const path = route('home', lang);
const h = helpers();
const sources = x.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const hasPage = (slug: string) => STATE_PAGES.some((p) => p.slug === slug);
const cell = (code: string, f: 'ho' | 'pr') => { const s = K.sum(code, f); if (!s) return 'not surveyed'; const ya = s.yearAgo ? ` (${K.pct(s.last[1] / s.yearAgo[1] - 1, 0)} on a year)` : ''; return `${K.ppg(s.last[1])}${ya}`; };
const rows = [...K.STATES].sort((a, b) => a.name.localeCompare(b.name)).map((s) => [
  hasPage(s.slug) ? `<a href="${route(stateId(s.slug), lang)}">${s.name}</a>` : s.name, cell(s.code, 'ho'), cell(s.code, 'pr'),
]);
rows.push(['<strong>U.S. average</strong>', cell('US', 'ho'), cell('US', 'pr')]);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
  </header>
  <div data-outil data-chrome><Tool kind="price" idPrefix="home" /></div>
  <p class="mt-3 text-sm text-navy-600">EIA weekly survey of <time datetime={K.L.last_week}>{K.day(K.L.last_week)}</time>, published {K.day(K.L.release_date)}, excluding taxes · next release {K.day(K.L.next_release)} · <a href={route('method', lang)} class="underline">How the figures are made</a> · <a href={route('about', lang)} class="underline">Who publishes this</a> · page updated <time datetime={LAST_UPDATED}>{K.day(LAST_UPDATED)}</time></p>
  <aside data-chrome class="mt-6 grid gap-3 sm:grid-cols-3" aria-label="This week in figures">
    <figure class="rounded-lg border border-navy-100 p-3"><figcaption class="text-xs uppercase tracking-wide text-navy-600">Heating oil, U.S.</figcaption><p class="text-2xl font-bold text-navy-900">{K.ppg(K.price('US', 'ho')!)}</p><p class="text-xs text-navy-600">a gallon, {K.ranked('ho').length} states surveyed</p></figure>
    <figure class="rounded-lg border border-navy-100 p-3"><figcaption class="text-xs uppercase tracking-wide text-navy-600">Propane, U.S.</figcaption><p class="text-2xl font-bold text-navy-900">{K.ppg(K.price('US', 'pr')!)}</p><p class="text-xs text-navy-600">a gallon, {K.ranked('pr').length} states surveyed</p></figure>
    <figure class="rounded-lg border border-navy-100 p-3"><figcaption class="text-xs uppercase tracking-wide text-navy-600">Next EIA release</figcaption><p class="text-2xl font-bold text-navy-900">{K.day(K.L.next_release)}</p><p class="text-xs text-navy-600">every Wednesday, October to March</p></figure>
  </aside>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <section data-chrome class="mt-8">
    <h2 class="font-serif text-2xl font-bold text-navy-900">Heating oil and propane prices in every surveyed state</h2>
    <Fragment set:html={table(['State', 'Heating oil a gallon', 'Propane a gallon'], rows, `EIA weekly residential prices, week of ${K.day(K.L.last_week)}, excluding taxes. In brackets: change from the same week a year ago.`, ['l', 'r', 'r'])} />
    <SeasonChart code="US" fuel="ho" name="the United States" />
  </section>
  <section class="mt-8"><Body html={x.why(h)} path={path} /></section>
  <section class="mt-10" data-chrome>
    <h2 class="font-serif text-2xl font-bold text-navy-900">Calculators and guides</h2>
    <div class="mt-4 grid gap-6 lg:grid-cols-3">
    {GROUPS.map((g) => (
      <article class="rounded-lg border border-navy-100 p-4">
        <h3 class="font-serif text-lg font-bold text-navy-900">{g.label}</h3>
        <ol class="mt-3 space-y-2 text-sm">
          {GUIDES.filter((p) => p.group === g.id && ROUTES.some((r) => r.id === p.id)).map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p.nav}</a><span class="block text-navy-600">{p.card}</span></li>)}
        </ol>
      </article>
    ))}
    </div>
  </section>
  <section class="mt-10">
    <h2 class="font-serif text-2xl font-bold text-navy-900">Before you call for a delivery</h2>
    {x.sections(h).map((s) => <details class="fold"><summary><h3 class="fold-h">{s.title}</h3></summary><div class="pb-4"><Body html={s.html} path={path} /></div></details>)}
  </section>
</PageLayout>
